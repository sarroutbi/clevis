#
# Verifies that a hybrid binding with the advertisement frozen in the
# JWE survives a signing-key rotation followed by the pruning of the
# retired signer: tang keeps serving the KEM key under its thumbprint
# and re-signs /adv-kem with the new signers, so the decrypt-time
# authentication of the fetch is the binding's 'kem_kid' thumbprint
# match, not the JWS.
#

. tang-pqc-common-test-functions

on_exit() {
    exit_status=$?
    tang_stop "${TMP}"
    [ -d "$TMP" ] && rm -rf "$TMP"
    exit "${exit_status}"
}

trap 'on_exit' EXIT

TMP="$(mktemp -d)"

tang_pqc_sanity_check

tang_run "${TMP}" sig exc
port=$(tang_get_port "${TMP}")

tang_pqc_check_version "${port}" \
    || skip_test "Tang server does not support hybrid PQC"

url="http://localhost:${port}"
adv="${TMP}/adv.jws"
adv_kem="${TMP}/adv-kem.jws"

# Save advertisements for an offline-provisioned binding: the verify
# keys frozen in the JWE are the current signing keys.
tang_get_adv "${port}" "${adv}"
tang_pqc_get_adv_kem "${port}" "${adv_kem}"

cfg="$(printf '{"url":"%s","adv":"%s","adv_kem":"%s"}' \
       "$url" "$adv" "$adv_kem")"
enc="$(echo -n "rotation test" | clevis encrypt tang-pqc "$cfg")"

# Rotate the server keys and prune the retired signing key (the
# post-grace cleanup): /adv-kem is then signed only by keys the
# binding never saw, while the hidden KEM key is still served under
# its thumbprint.
tang_new_keys "${TMP}" "rotate-keys"
rm -f "${TMP}/db/.sig.jwk"

# Decrypt must succeed: the binding's 'kem_kid' thumbprint match
# authenticates the still-served KEM key even though its signature
# no longer verifies with the frozen keys.
dec="$(echo -n "$enc" | clevis decrypt)"
test "$dec" == "rotation test"

echo "Successfully tested decrypt after signing-key rotation" >&2
