#
# Verifies the decrypt-time authentication of the KEM-key fetch
# against a substituting man in the middle. A relay in front of a
# real Tang server serves its own /adv (so the live, unverified
# advertisement carries the attacker's verify key) and substitutes
# the /adv-kem response with its own KEM key, signed by its own
# signer. Four cases are checked:
#
# 1. Online (no stored advertisement): the signature verifies with
#    the attacker-supplied verify keys, but the binding's 'kem_kid'
#    does not match the substituted key. The decrypt must reject it
#    as a substitution instead of encapsulating against the
#    attacker's key.
# 2. Offline (frozen advertisement): the substituted response fails
#    both the signature check against the frozen verify keys and the
#    pin. The decrypt must keep failing hard with the "possible
#    MITM" diagnostic.
# 3. Binding against a bare (unsigned) /adv key set fetched from
#    the network, carrying the genuine signing key next to the
#    attacker's exchange key and matching the trusted thumbprint:
#    the encryption must be rejected -- without a signature nothing
#    ties the exchange keys to the signing key.
# 4. Binding against a signed /adv but a bare (unsigned) /adv-kem
#    listing fetched from the network: the encryption must be
#    rejected the same way.
#

. tang-pqc-common-test-functions

TEST="${0}"

on_exit() {
    exit_status=$?
    for pid in ${RELAY_PIDS}; do
        kill -9 "${pid}" 2>/dev/null || :
    done
    tang_stop "${TMP}"
    [ -d "$TMP" ] && rm -rf "$TMP"
    exit "${exit_status}"
}

trap 'on_exit' EXIT

TMP="$(mktemp -d)"
RELAY_PIDS=""

tang_pqc_sanity_check
command -v python3 >/dev/null 2>&1 \
    || skip_test "substitution test needs python3"

tang_run "${TMP}" sig exc
port=$(tang_get_port "${TMP}")

tang_pqc_check_version "${port}" \
    || skip_test "Tang server does not support hybrid PQC"

url="http://localhost:${port}"
adv="${TMP}/adv.jws"
adv_kem="${TMP}/adv-kem.jws"

# The real advertisements, for the offline binding and for the ECMR
# key the attacker must relay to keep the binding usable.
tang_get_adv "${port}" "${adv}"
tang_pqc_get_adv_kem "${port}" "${adv_kem}"

# The attacker's material: its own signing key and its own KEM key.
subsig="${TMP}/attacker-sig.jwk"
subkem="${TMP}/attacker-kem.jwk"
jose jwk gen -i '{"alg":"ES512"}' -o "${subsig}"
jose jwk gen -i '{"alg":"ML-KEM-768"}' -o "${subkem}"
subsig_pub="$(jose jwk pub -i "${subsig}")"
subkem_pub="$(jose jwk pub -i "${subkem}")"

# The attacker's /adv: its own verify key plus the real ECMR key,
# signed by its own signer (the binding-time JWS chain is
# self-consistent, like a real server's). The real signing key is
# absent on purpose.
real_exc="$(jose fmt --json="$(cat "${adv}")" -Og payload -SyOo- \
            | jose jwk use -i- -r -u deriveKey -o-)"
fake_adv="${TMP}/attacker-adv.jws"
printf '{"keys":[%s,%s]}' "${subsig_pub}" "${real_exc}" \
    > "${TMP}/attacker-adv.payload"
jose jws sig -I "${TMP}/attacker-adv.payload" \
    -k "${subsig}" -o "${fake_adv}"

# The attacker's /adv-kem listing (binding time): the REAL KEM key,
# re-signed by the attacker's signer so the binding-time verification
# against the attacker's /adv keys passes and the binding pins the
# real kem_kid.
real_kem768="$(jose fmt --json="$(cat "${adv_kem}")" -Og payload -SyOo- \
               | jose fmt -j- -Og keys -Af- \
               | grep '"ML-KEM-768"')"
fake_advkem_listing="${TMP}/attacker-adv-kem-listing.jws"
printf '{"keys":[%s]}' "${real_kem768}" \
    > "${TMP}/attacker-adv-kem-listing.payload"
jose jws sig -I "${TMP}/attacker-adv-kem-listing.payload" \
    -k "${subsig}" -o "${fake_advkem_listing}"

# The attacker's substituted /adv-kem/<thumbprint> (decrypt time):
# its own KEM key, signed by its own signer, so the JWS verifies
# against the attacker's /adv keys.
fake_advkem="${TMP}/attacker-adv-kem.jws"
printf '{"keys":[%s]}' "${subkem_pub}" \
    > "${TMP}/attacker-adv-kem.payload"
jose jws sig -I "${TMP}/attacker-adv-kem.payload" \
    -k "${subsig}" -o "${fake_advkem}"

# The attacker's bare (unsigned) key sets for the network-fetch
# scenarios: a /adv set carrying the genuine signing key -- so the
# trusted thumbprint matches -- next to the attacker's own exchange
# key, and a bare /adv-kem listing with the attacker's KEM key.
# Nothing ties the exchange keys to the signing key without a
# signature, so these must be rejected when fetched from the server.
genuine_sig_pub="$(jose jwk pub -i "${TMP}/db/sig.jwk")"
genuine_thp="$(jose jwk thp -i "${TMP}/db/sig.jwk" -a S256)"
subsig_thp="$(jose jwk thp -i "${subsig}" -a S256)"
attacker_exc="${TMP}/attacker-exc.jwk"
jose jwk gen -i '{"alg":"ECMR","crv":"P-521"}' -o "${attacker_exc}"
attacker_exc_pub="$(jose jwk pub -i "${attacker_exc}")"
bare_adv="${TMP}/attacker-adv-bare.json"
printf '{"keys":[%s,%s]}' \
    "${genuine_sig_pub}" "${attacker_exc_pub}" > "${bare_adv}"
bare_advkem_listing="${TMP}/attacker-adv-kem-bare.json"
printf '{"keys":[%s]}' "${subkem_pub}" > "${bare_advkem_listing}"

# The relay in front of the real server: it substitutes /adv (and
# /adv/<thumbprint>), the /adv-kem listing (binding time) and
# /adv-kem/<thumbprint> (decrypt time), and forwards everything else,
# so the classical recovery leg keeps working through the real
# server.
relay_py="${TMP}/relay.py"
cat > "${relay_py}" <<'PYEOF'
import sys
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

upstream, fake_adv, fake_listing, fake_advkem, portfile = sys.argv[1:6]


class Handler(BaseHTTPRequestHandler):
    protocol_version = 'HTTP/1.1'

    def _file(self, path):
        with open(path, 'rb') as f:
            body = f.read()
        self.send_response(200)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _relay(self):
        length = int(self.headers.get('Content-Length') or 0)
        body = self.rfile.read(length) if length else None
        request = urllib.request.Request(
            upstream + self.path, data=body, method=self.command)
        if self.headers.get('Content-Type'):
            request.add_header('Content-Type',
                               self.headers['Content-Type'])
        try:
            with urllib.request.urlopen(request) as response:
                status = response.status
                data = response.read()
                ctype = response.headers.get('Content-Type',
                                             'application/json')
        except urllib.error.HTTPError as error:
            status = error.code
            data = error.read()
            ctype = 'application/json'
        self.send_response(status)
        self.send_header('Content-Type', ctype)
        self.send_header('Content-Length', str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path.startswith('/adv-kem/'):
            self._file(fake_advkem)
        elif self.path.startswith('/adv-kem'):
            self._file(fake_listing)
        elif self.path.startswith('/adv'):
            self._file(fake_adv)
        else:
            self._relay()

    def do_POST(self):
        self._relay()

    def log_message(self, *_args):
        pass


server = ThreadingHTTPServer(('localhost', 0), Handler)
with open(portfile, 'w') as f:
    f.write(str(server.server_port))
server.serve_forever()
PYEOF

start_relay() {
    # $1: /adv response, $2: /adv-kem listing, $3: /adv-kem/<thp>;
    # sets relay_port.
    local portfile="${TMP}/relay-port-$$.port"
    rm -f "${portfile}"
    python3 "${relay_py}" "${url}" "${1}" "${2}" "${3}" \
        "${portfile}" >/dev/null 2>&1 &
    RELAY_PIDS="${RELAY_PIDS} $!"
    for _ in $(seq 1 50); do
        [ -s "${portfile}" ] && break
        sleep 0.1
    done
    relay_port="$(cat "${portfile}")"
}

start_relay "${fake_adv}" "${fake_advkem_listing}" "${fake_advkem}"
proxy_port="${relay_port}"
proxy_url="http://localhost:${proxy_port}"

# 1. Online binding through the relay: the advertisement is not
#    stored, so the decrypt-time verify keys come from the attacker's
#    /adv and the substituted JWS verifies. The kem_kid thumbprint
#    match must still reject the substituted KEM key.
cfg_online="$(printf '{"url":"%s"}' "${proxy_url}")"
enc_online="$(echo -n "substitution online" \
              | clevis encrypt tang-pqc "${cfg_online}" -y)"

if echo -n "${enc_online}" | clevis decrypt 2>"${TMP}/stderr-online"; then
    error "${TEST}: Substituted KEM key must be rejected (online mode)."
fi
grep -q "does not match the binding's 'kem_kid'" "${TMP}/stderr-online" \
    || error "${TEST}: Expected the substitution diagnostic, got:" \
             "$(cat "${TMP}/stderr-online")"

# 2. Offline binding with the real advertisements frozen, decrypting
#    through the relay: the substituted response fails both the
#    signature check against the frozen keys and the kem_kid match.
cfg_offline="$(printf '{"url":"%s","adv":"%s","adv_kem":"%s"}' \
               "${proxy_url}" "${adv}" "${adv_kem}")"
enc_offline="$(echo -n "substitution offline" \
               | clevis encrypt tang-pqc "${cfg_offline}")"

if echo -n "${enc_offline}" | clevis decrypt 2>"${TMP}/stderr-offline"; then
    error "${TEST}: Substituted KEM key must be rejected (offline mode)."
fi
grep -q "KEM key signature verification failed" "${TMP}/stderr-offline" \
    || error "${TEST}: Expected the signature diagnostic, got:" \
             "$(cat "${TMP}/stderr-offline")"
grep -q "possible MITM" "${TMP}/stderr-offline" \
    || error "${TEST}: Expected the MITM diagnostic, got:" \
             "$(cat "${TMP}/stderr-offline")"

# 3. A bare (unsigned) /adv key set fetched from the network, with
#    the genuine signing key -- whose thumbprint the configuration
#    trusts -- next to the attacker's exchange key, and a bare
#    /adv-kem listing with the attacker's KEM key: without a
#    signature nothing ties the exchange keys to the signing key, so
#    the encryption must be rejected instead of binding to the
#    attacker's keys.
start_relay "${bare_adv}" "${bare_advkem_listing}" "${fake_advkem}"
bare_adv_url="http://localhost:${relay_port}"
cfg_bare_adv="$(printf '{"url":"%s","thp":"%s"}' \
                "${bare_adv_url}" "${genuine_thp}")"

if echo -n "bare adv" | clevis encrypt tang-pqc "${cfg_bare_adv}" \
        2>"${TMP}/stderr-bare-adv" \
        > "${TMP}/bare-adv.jwe"; then
    error "${TEST}: Bare advertisement from the server must be rejected."
fi
grep -q "Advertisement from the server is not signed" \
    "${TMP}/stderr-bare-adv" \
    || error "${TEST}: Expected the unsigned diagnostic, got:" \
             "$(cat "${TMP}/stderr-bare-adv")"

# 4. A signed /adv but a bare (unsigned) /adv-kem listing fetched
#    from the network: rejected the same way.
start_relay "${fake_adv}" "${bare_advkem_listing}" "${fake_advkem}"
bare_kem_url="http://localhost:${relay_port}"
cfg_bare_kem="$(printf '{"url":"%s","thp":"%s"}' \
                "${bare_kem_url}" "${subsig_thp}")"

if echo -n "bare adv-kem" | clevis encrypt tang-pqc "${cfg_bare_kem}" \
        2>"${TMP}/stderr-bare-kem" \
        > "${TMP}/bare-kem.jwe"; then
    error "${TEST}: Bare KEM advertisement must be rejected."
fi
grep -q "KEM advertisement from the server is not signed" \
    "${TMP}/stderr-bare-kem" \
    || error "${TEST}: Expected the unsigned diagnostic, got:" \
             "$(cat "${TMP}/stderr-bare-kem")"

echo "Successfully tested KEM key substitution rejection" >&2
